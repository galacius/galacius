{
  "name": "@galacius/design-system",
  "version": "1.0.0",
  "description": "Design system components, utilities, and hooks for galacius",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galacius/galacius.git",
    "directory": "packages/design-system"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./atoms": {
      "import": "./dist/atoms/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js"
    },
    "./utils": {
      "import": "./dist/utils/index.js"
    },
    "./libs": {
      "import": "./dist/libs/index.js"
    },
    "./styles": {
      "import": "./dist/styles.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/styles.js"
  ],
  "scripts": {
    "build": "tsup",
    "build:report": "cross-env ANALYZE=true tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "esbuild-visualizer": "catalog:",
    "jsdom": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
